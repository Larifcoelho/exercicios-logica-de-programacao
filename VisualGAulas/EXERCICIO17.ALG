Algoritmo "Exercicio17"

Var
// Seção de Declarações das variáveis 
raio:real;
area:real;


Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
Escreval ("Descubra o valor da área de um círculo ")
Escreva("Digite o valor do raio: ")
leia(raio)

area<- 3,14 * raio^2

Escreval("O valor de área é de: ", area)


Fimalgoritmo